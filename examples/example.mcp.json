{
    "mcpServers": {
        "github-mcp": {
            "type": "http",
            "url": "https://api.githubcopilot.com/mcp/",
            "headers": {
                "Authorization": "Bearer GITHUB_TOKEN"
            },
            "tools": [
                "search_repositories",
                "search_code",
                "get_file_contents"
            ]
        },
        "context7-mcp": {
            "type": "http",
            "url": "https://mcp.context7.com/mcp",
            "headers": {
                "CONTEXT7_API_KEY": "CONTEXT7_API_KEY"
            }
        },
        "microsoft-markitdown-mcp": {
            "type": "stdio",
            "command": "uvx",
            "args": [
                "markitdown-mcp"
            ]
        },
        "sequential-thinking-mcp": {
            "type": "stdio",
            "command": "npx",
            "args": [
                "-y",
                "@modelcontextprotocol/server-sequential-thinking"
            ]
        },
        "fetch-mcp": {
            "type": "stdio",
            "command": "uvx",
            "args": [
                "mcp-server-fetch"
            ]
        },
        "searchcode-mcp": {
            "type": "http",
            "url": "https://api.searchcode.com/v1/mcp"
        }
    }
}
